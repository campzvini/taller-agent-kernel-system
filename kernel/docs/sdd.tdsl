# Governed Delivery (.task)

¶ - Lifecycle, authority and reconciliation for intended, observed and historical project state.

document:
  id: task.sdd-policy@2
  version: 2
  status: proposed
  authority_basis: [@task/global-policy @arch/tdsl-sdd @arch/tdsl-language]
  scope: lifecycle, layout, authority, reconciliation, modes, delivery, migration
  excludes: dialect_field_types, phase_authoring_procedure
  entry: skill(protocol)

¶ 1 — Backbone

flow:
  planning -> constitution, architecture, features, specs, plans, tasks, analysis
  integral_ready -> execute_zero, execution_loop
  gradual_ready -> execution_loop
  execution_loop -> resolve, verify, delegate, record, update, next_eligible_unit
  exhausted -> report, idle
rule: dependencies_determine_order; existence_never_grants_authority

¶ 2 — State and Authority

state:
  intended: [constitution architecture features specs plans tasks]
  observed: [directories files source artifacts]
  historical: [execution_journal decisions_journal failures_journal]
authority:
  constitution: highest_project_normative_authority
  source: material_truth_of_existing_behavior
  index: navigation_projection_only
  journal: historical_evidence_not_permission
rule: observed_behavior_conflicts_with_constitution -> reconcile_within_authority
ban: code_normatively_correct_by_existence
ban: date_alone_selecting_a_superseding_decision

¶ 3 — Layout

layout:
  anchor: .task/project.tdsl
  execution_config: .task/execution.config.tdsl
  constitution: .task/constitution.tdsl
  constitution_history: .task/history/constitution/
  architecture: .task/Architecture.md
  feature: .task/features/<id>/
  planning: [spec.tdsl plan.tdsl tasks.tdsl analysis.tdsl]
  legacy_execution: .task/features/<id>/execution.journal.tdsl
  journals: .task/journals/
  execution_journal: .task/journals/execution.journal.tdsl
  decisions_journal: .task/journals/decision.journal.tdsl
  failures_journal: .task/journals/failure.journal.tdsl
  identity_registry: .task/tracking/registry.json
  projections: .agent-cache/tracking/
  authoring_skeletons: .task/.scaffold/
rule: projections_rebuildable; identity_registry_persistent
rule: no_comments_safe -> identity_external_only
rule: legacy_execution_records_remain_readable

¶ 4 — Invariants

invariants:
  sequence_before_author: predecessors_exist_and_references_resolve
  one_proposition_one_location: downstream_references_upstream
  runtime_is_not_planning: progress_and_evidence_in_journals_only
  authority_is_explicit: mode_never_grants_it_by_name
  identity_is_not_location: refs_survive_rename_and_renumbering
  tracker_is_mechanical: no_tests_quality_or_completion_judgment
  no_silent_identity_guess: ambiguous_move_is_unresolved
  no_silent_autonomy_upgrade: legacy_projects_stay_interactive
  test_gate_owner: orchestrator
  no_duplicate_checklist_state: derive_from_execution_journal

¶ 5 — Constitution Revisions and Controlled Return

constitution_revision:
  immutable: each_published_version
  amendment: explicit_revision_under_declared_authority
  preserve: prior_version_and_references
  current_path: .task/constitution.tdsl
  historical_path: .task/history/constitution/<version>.tdsl
controlled_return:
  semantic_defect -> owning_record
  technical_answer_available -> resolve_within_authority, record_material_decision
  real_unknown_or_outside_authority -> operator
  structural_change -> update_architecture_and_affected_planning, reconcile_index
  preserve: decision_and_failure_history
ban: mutating_unrelated_predecessor_to_satisfy_a_check
ban: inferring_an_operator_preference

¶ 6 — Planning and Execution Modes

planning_mode:
  gradual: one_feature_cycle_at_a_time
  integral: all_declared_features_planned_before_implementation
execution_mode:
  interactive: progressive_delivery_operator_handles_material_undelegated_choices
  autonomous: continue_until_exhausted_or_real_block_within_explicit_authority
configuration:
  max_active_subagents: 1
  separate_test_author: true
rule: autonomous_integral -> complete_package_then_execute_zero_then_loop
rule: integral_interactive -> package_ready_report_then_execute_only_when_authorized
rule: planning_mode_and_execution_mode_are_independent
rule: feature_dependencies_form_a_DAG; ids_are_tie_breakers_not_dependencies
rule: integral_analysis_scope_covers_all_declared_features

¶ 7 — Architecture

architecture:
  path: .task/Architecture.md
  owner: skill(architecture)
  body: complete_intended_directory_and_file_tree_only
  excludes: [requirements behavior component_descriptions task_status]
  identity_and_relations: external_registry
  precedes: feature_planning
  additions: allowed_with_material_justification_and_affected_source_updates
rule: architecture_is_intent_not_inventory
rule: inspect_existing_structure_before_creation

¶ 8 — Execute Zero

execute_zero:
  applies: integral_mode
  implementation: structure_scaffold.py
  before_creation: resolve_destinations, inspect_existing, preserve_existing_files
  creates: missing_safe_directories_and_source_placeholders
  sections: provisional_marker_◇_with_stable_anchor_ref
  after_creation: reconcile_registry_and_indices, record_result
  unsafe_placeholder: pending_with_reason
  excludes: fake_binaries_invalid_manifests_fake_lockfiles
rule: scaffold_is_not_implementation_or_validation
rule: rerun_idempotent_and_non_overwriting
rule: gradual_mode_may_scaffold_only_next_unit

¶ 9 — Reconciliation Before Intervention

intervention:
  1: resolve_unit_and_destination_refs
  2: consult_applicable_constitution_and_planning
  3: consult_relevant_state_decisions_and_failures
  4: inspect_existing_destination
  5: choose_reuse_modify_create_or_no_action
  6: execute_within_authority_and_write_scope
  7: record_material_events_decisions_failures
  8: reconcile_indices
read_strategy: index_then_targeted_range_then_expand_only_when_insufficient
ban: rereading_all_documents_per_task

¶ 10 — Lifecycle and Retrying

feature_lifecycle: [active delivered heritage historical superseded abandoned]
cursor: navigation_not_exclusive_execution_state
rules:
  delivered: declared_validations_pass_with_evidence
  superseded: explicit_successor_without_cycle
  abandoned: explicit_reason
  close: operator_direction_or_predelegated_constitution_authority
  next_feature: only_within_declared_package_and_authority
  retry: new_event_identity_preserves_previous_attempt
  interrupted_unit: reconcile_claim_and_attempt_before_resuming
  completion: never_inferred_from_promotion_or_scaffold_presence
rule: no_work_remaining -> idle_without_new_scope

¶ 11 — Orchestration

roles:
  orchestrator: persistent_intent_recovery_selection_validation_and_closure
  executor: replaceable_implementation_owner_of_assigned_unit
  test_author: independent_when_configuration_requires_separation
unit:
  may_be: [whole_feature task_group single_task]
  selection: dependencies_difficulty_context_and_write_ownership
  difficulty: [low medium high]
  high: prefer_dedicated_executor
concurrency:
  default: 1
  maximum: active_subagents_not_total_lifetime_spawns
  parallel: independent_units_with_disjoint_write_scopes
  scope_includes: [source tests journals reports indices temporaries]
  shared_writer: orchestrator_or_designated_single_writer
rule: executor_delivers_evidence_then_ends; orchestrator_selects_next
rule: precise_failure -> same_executor_when_available
rule: executor_never_runs_test_gate_or_escalates_directly_to_operator

¶ 12 — Validation and Closure

validation:
  criteria: constitution_spec_plan_and_independent_references
  triage: before_test_authoring
  separate_test_author_true: author_does_not_read_implementation
  separate_test_author_false: criteria_still_independent_of_implementation
  gate: orchestrator_runs_required_build_and_suite
  absent_required_validation: blocked_not_completed
  failure: resolve_known_answer_before_operator_escalation
  prohibit: weakening_or_deleting_tests_to_claim_success
closure:
  required_validations_pass -> record_evidence, release_unit, close_if_authorized
  real_block -> record_why_sources_cannot_resolve_it, report
ban: extra_spikes_or_comparative_validation_when_answer_known

¶ 13 — Operational Journals

journals:
  execution: event_id_task_ref_attempt_timestamp_outcome_validation_and_evidence
  decisions: decision_id_task_ref_timestamp_question_choice_rationale_evidence_refs
  failures: failure_id_task_ref_cause_effect_resolution_rationale_evidence_refs_resolution_state
rules:
  append_only: corrections_and_retries_are_new_events
  decision_supersession: explicit_target_and_partial_or_full_scope
  failure_inclusion: material_recurring_architectural_contract_or_consequential_only
  trivial_immediate_error: omit
  failure_causes_decision: cross_reference_both_records
  task_completion_view: reconstructed_from_execution_events
  scope: journals_may_reference_any_chain_element
ban: completion_state_in_both_tasks_and_journal

¶ 14 — Tracking and Hooks

tracker:
  identity: typed_refs_without_content_hash_identity
  inventory: all_elements_within_declared_boundary
  detects: [missing duplicate unresolved removed moved provisional promoted]
  moves: explicit_operation_or_unambiguous_preserved_marker
  ambiguous: unresolved_for_reconciliation
  publication: locked_and_atomic
  projections: Markdown_and_machine_queries
hooks:
  before_write: load_policy_and_validate_relevant_contract
  after_write_when_supported: reconcile_and_report_structural_findings
  missing_hook: explicit_reconciliation_command
  independent: full_scan_at_resume_and_before_closure
rule: hook_failure_never_substitutes_for_explicit_reconciliation

¶ 15 — Commands and Compatibility

commands:
  state: python {{KERNEL_HOME}}/scripts/sdd_gate.py state
  roadmap: python {{KERNEL_HOME}}/scripts/sdd_gate.py roadmap
  tracker: python {{KERNEL_HOME}}/scripts/structure_tracker.py --root . scan
  query: python {{KERNEL_HOME}}/scripts/structure_tracker.py --root . query <ref>
  scaffold: python {{KERNEL_HOME}}/scripts/structure_scaffold.py --root . --apply
  runtime: python {{KERNEL_HOME}}/scripts/execution_runtime.py --root . status
  reconcile: python {{KERNEL_HOME}}/scripts/execution_runtime.py --root . reconcile
  journals: python {{KERNEL_HOME}}/scripts/runtime_journal.py --root . query
compatibility:
  old_dialects: remain_readable
  old_anchor: preserve_existing_planning_mode_default_execution_to_interactive
  upgrade: explicit_migration_preserves_records_and_never_grants_autonomy
  schema_changes: new_major_when_required_fields_or_authority_change
  hashes: schema_revision_only_not_element_identity
  unsafe_placeholder: defer_to_declared_owner_task_after_safe_scaffold_preparation_never_block_its_creation
  legacy_markdown_specs: operator_directed_adoption
